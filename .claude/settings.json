{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(android info:*)",
      "Bash(android describe:*)",
      "Bash(android docs:*)",
      "Bash(android layout:*)",
      "Bash(android screen:*)",
      "Bash(android emulator list:*)",
      "Bash(android skills list:*)",
      "Bash(adb devices:*)",
      "Bash(adb logcat:*)",
      "Bash(adb shell getprop:*)",
      "Bash(adb shell dumpsys:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(adb*install*)",
      "Bash(adb*push*)",
      "Bash(adb*shell pm*)",
      "Bash(adb*shell su*)",
      "Bash(adb*shell settings*)",
      "Bash(adb*shell rm*)",
      "Bash(adb*reboot*)",
      "Bash(android sdk remove:*)",
      "Bash(android emulator remove:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git diff*--output*)",
      "Bash(git log*--output*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-kotlin.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "kotlin-lsp@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  }
}
